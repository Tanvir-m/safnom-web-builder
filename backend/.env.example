NODE_ENV=development
# Use 8080 on macOS — AirPlay often occupies 5000
PORT=8080
MONGODB_URI=mongodb://localhost:27017/safnom
FRONTEND_URL=http://localhost:3000
API_PREFIX=/api/v1

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
COOKIE_NAME=safnom_token

# Firebase Admin (Google sign-in — verify ID tokens from the web app)
# Service account: Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste private_key from JSON only (not the whole file). One line with \n for breaks, no extra quotes:
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n
FIREBASE_PRIVATE_KEY=

# console = log only (dev) | smtp = Gmail/custom SMTP | resend = verified domain only (not @gmail.com)
EMAIL_PROVIDER=smtp
EMAIL_FROM="Safnom <safnomtech@gmail.com>"
# Gmail: create an App Password at https://myaccount.google.com/apppasswords (2FA required)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=safnomtech@gmail.com
SMTP_PASS=
RESEND_API_KEY=

# Media (Step 6)
MEDIA_MAX_FILE_SIZE_BYTES=5242880
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_ROOT=./data/media

# AI (Step 7)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
AI_BASE_URL=https://api.openai.com/v1

# Templates (catalog)
# code = load from repo files (default, good for dev/tests)
# mongo = load published templates from MongoDB (run npm run seed:templates first)
TEMPLATE_SOURCE=code
# Optional — shared cache for template definitions + workspace previews (falls back to in-memory if unset or unreachable)
REDIS_URL=
TEMPLATE_CACHE_TTL_SECONDS=3600
